{
  "name": "nightshift",
  "version": "0.1.0",
  "private": true,
  "description": "Overnight supervisor for headless coding agents (Claude Code, Codex, OpenCode).",
  "type": "module",
  "bin": {
    "nightshift": "src/cli.mjs"
  },
  "files": [
    "src",
    "prompts",
    "templates",
    "docker",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junaed93/NightShift.git"
  },
  "keywords": [
    "agent",
    "autonomous",
    "claude-code",
    "codex",
    "opencode",
    "orchestrator"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "run": "node src/cli.mjs run",
    "once": "node src/cli.mjs run --once",
    "status": "node src/cli.mjs status",
    "demo": "node src/cli.mjs run --once --dry-run"
  }
}
